<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head.ejs", { title: title }); %>
</head>
<body>
    <%- include("./partials/background.ejs"); %>
    <header>
        <%- include("./partials/header.ejs", { header: header }); %>
    </header>
    <nav>
        <%- include("./partials/navbar.ejs"); %>
    </nav>
    <aside class="user-area" aria-label="user area">
        <% if (locals.user) { %>
            <%- include("./partials/user-area"); %>
        <% } %>
        </aside>
    <main class='<%= locals.user ? "index" : "" %>'>
        <% if (!locals.user) { %>
            <h2>You are not logged in</h2>
            <p>Please <a href="/sign-in">sign in to see your files...</a></p>
        <% } %>
        <%- include("./partials/files.ejs", { files: files }); %>

    </main>
    <footer>
        <%- include("./partials/footer.ejs", { links: links }); %>
    </footer>
</body>
</html>

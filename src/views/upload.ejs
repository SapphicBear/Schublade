<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head.ejs", { title: title }); %>
</head>
<body>
    <%- include("./partials/background.ejs"); %>
    <header>
        <%- include("./partials/header.ejs", { header: header }); %>
    </header>
    <nav>
        <%- include("./partials/navbar.ejs") %>
    </nav>
    <aside class="user-area" aria-label="user area">
        <%- include("./partials/user-area.ejs"); %>
    </aside>
    <main class="upload">
        <form action="/upload" method="post" enctype="multipart/form-data">
            <div class="form-row">
                <label for="file">Upload your file:</label>
                <input type="file" name="file" id="file" />
            </div>
            <div class="form-row">
                <label for="folders">Folder:</label>
                <select name="folders" id="folders">
                    <% folders.map((folder) => { %>
                        <option value="<%= folder.id %>"><%= folder.name %></option>
                    <% }); %>
                </select>
            </div>
            <button type="submit" class="button">Upload</button>
        </form>
    </main>
    <footer>
        <%- include("./partials/footer.ejs", { links: links }); %>
    </footer>
</body>
</html>

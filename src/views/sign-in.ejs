<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head.ejs", { title: title }); %>
</head>
<body class="sign-in">
    <%- include("./partials/background.ejs"); %>
    <header>
        <%- include("./partials/header.ejs", { header: header }); %>
    </header>
      
    <main aria-labelledby="main">
        <h2 id="main">Sign in</h2>
        <form action="/sign-in" method="post">
            <div class="form-row">
                <label for="email">Email:</label>
                <input type="email" name="email" id="email" placeholder="Email..." autocomplete="off"/>
            </div>
            <div class="form-row">
                <label for="password">Password:</label>
                <input type="password" name="password" id="password" placeholder="Password..."/>
            </div>
            <button type="submit" class="button">Submit</button>
            <p>Don't have an account? <a href="/sign-up">Click here to sign up!</a></p>
        </form>

    </main>
    <footer>
        <%- include("./partials/footer.ejs", { links: links }); %>
    </footer>
</body>
</html>

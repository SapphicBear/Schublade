<h3 class="file-area">Files</h3>
<hr></hr>
<ul class="files">
    <% if (locals.currentFolder) { %>
        <p>Folder: <%= currentFolder.name %></p>
    <% } %>
    <% if (!files.length > 0) { %>
        <li class="file">No files yet...</li>
    <% } else { %>
        <% files.map((file, i) => { %>
            <li class="file <%= i %>">
                <h4 class="name"><%= file.name %></h4>
                <p>Date uploaded: <%= file.created %></p>
                <p>Author: <%= user.name %></p>
                <p>Type: <%= file.type %></p>
                <% folders.map((folder) => { %>
                    <p><%= folder.id === file.folderId ? "Folder: " + folder.name : ""%></p>
                <% }); %>
            </li>
       <% }); %>
    <% } %>
</ul>

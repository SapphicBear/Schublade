<div class="folder-top">
    <h4>Folders</h4>
    <button class="button add-button" type="button" id="new-folder-button" command="show-modal" commandfor="add-folder-dialog">+</button>
</div>
<dialog id="add-folder-dialog">
    <div class="dialog-wrapper stack">
    <h4>Add a new folder</h4>
    <form action="/new-folder" method="post" class="stack dialog-form">
        <div class="form-row">
        <label for="folder-name" id="required">Enter a folder name...</label>
        <input type="text" name="folder-name" id="folder-name" placeholder="e.g. Videos..." required/>
        </div>
    <button id="dialog-submit" class="button" type="submit">Add</button>
    </form>
    <button class="button" commandfor="add-folder-dialog" command="close">Close</button>
    </div>
</dialog>

<% if (locals.folders) { %>
    <ul class="folders">
        <% folders.map((folder, i) => { %>
        <li class="folder<%= i %>"><i class="fa-solid fa-folder-closed"></i><a href="/folder/<%= folder.id %>"><%= folder.name %></a></li>
        <% }); %>
    </ul>
<% } %>

<h4>Folders</h4>

<% if (locals.folders) { %>
    <ul class="folders">
        <% folders.map((folder, i) => { %>
            <li class="folder<%= i %>"><a href="<%= folder.href %>"><%= folder.name %></a></li>
        <% }); %>
    </ul>
<% } %>

<button type="button" id="new-folder-button" command="show-modal" commandfor="add-folder-dialog">New Folder</button>

<dialog id="add-folder-dialog">
    <p>Add a new folder!</p>
    <button commandfor="add-folder-dialog" command="close">Close</button>
</dialog>

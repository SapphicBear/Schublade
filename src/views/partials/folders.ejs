<h4>Folders</h4>

<% if (locals.folders) { %>
    <ul class="folders">
        <% folders.map((folder, i) => { %>
            <li class="folder<%= i %>"><a href="<%= folder.id %>"><%= folder.name %></a></li>
        <% }); %>
    </ul>
<% } %>

<button type="button" id="new-folder-button" command="show-modal" commandfor="add-folder-dialog">New Folder</button>

<dialog id="add-folder-dialog">
    <h4>Add a new folder</h4>
    <form action="/new-folder" method="post" class="dialog-form">
    <label for="folder-name">Enter a folder name...</label>
        <input type="text" name="folder-name" id="folder-name" placeholder="e.g. Videos..."/>
    <button id="dialog-submit" type="submit">Add</button>
    </form>
    <button commandfor="add-folder-dialog" command="close">Close</button>
</dialog>

<h4>Folders</h4>

<% if (locals.folders) { %>
    <ul class="folders">
        <% folders.map((folder, i) => { %>
            <li class="folder<%= i %>"><a href="<%= folder.href %>"><%= folder.name %></a></li>
        <% }); %>
    </ul>
<% } %>

<button type="button" id="new-folder-button">New Folder</button>

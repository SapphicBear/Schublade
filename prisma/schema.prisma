generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  password    String
  name        String?
  permissions Permission @default(Normal)
  files       File[]
  folders     Folder[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model File {
  id       Int      @id @default(autoincrement())
  userId   Int
  created  DateTime @default(now())
  type     String
  url      String?
  name     String
  user     User     @relation(fields: [userId], references: [id])
  folderId Int
  folder   Folder   @relation(fields: [folderId], references: [id])
}

model Folder {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String @default("Home")
  user   User   @relation(fields: [userId], references: [id])
  files  File[]
}

enum Permission {
  Normal
  Member
  Admin
}
